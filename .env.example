APP_NAME=NestBoilerPlate
APP_KEY=your_app_secret_key
APP_ENV=development
APP_DEBUG=true
APP_HOST=localhost
APP_PORT=3000

# Database Configuration
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_boilerplate

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=86400

# Other Configurations
LOG_LEVEL=debug
LOG_PATH=your_log_path
SESSION_SECRET=your_session_secret_key
CACHE_TTL=600

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUEST=100