APP_NAME=NestBoilerPlate
APP_KEY=your_app_secret_key
APP_ENV=development
APP_DEBUG=true
APP_HOST=localhost
APP_PORT=3000
APP_TIMEZONE=Asia/Jakarta
PUBLIC_URL=http://localhost:3000

# Database Configuration
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_postgres_password
DB_NAME=db_boilerplate

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_SECRET=your_session_secret_key
CACHE_TTL=600

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=10800 # 3 hours

# Other Configurations
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Upload
UPLOAD_DRIVER=local        # local | s3
UPLOAD_DIR=storage/app
UPLOAD_MAX_SIZE=2000000    # 2MB
UPLOAD_ALLOWED_MIME=image/png,application/pdf,image/jpeg,image/jpg,application/xlsx,application/xls

# S3 (if UPLOAD_DRIVER is s3)
S3_REGION=ap-southeast-1
S3_BUCKET=my-bucket
S3_ACCESS_KEY=xxxx
S3_SECRET_KEY=xxxx

# Global default (per IP)
RATE_LIMIT_GLOBAL_TTL=60        # 60 detik
RATE_LIMIT_GLOBAL_COUNT=20      # Max 20 request per IP per TTL

# Auth routes (login, register, verify)
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_COUNT=5

# Sensitive routes (password reset, 2FA verify)
RATE_LIMIT_SENSITIVE_TTL=60
RATE_LIMIT_SENSITIVE_COUNT=3

# Admin / internal routes
RATE_LIMIT_ADMIN_TTL=60
RATE_LIMIT_ADMIN_COUNT=100

# Cors Configuration
CORS_ORIGIN_URL=https://frontend.com,https://admin.frontend.com